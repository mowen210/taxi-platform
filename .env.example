# ===== 数据库 =====
DB_HOST=mysql
DB_PORT=3306
DB_NAME=taxi_platform
DB_USERNAME=root
DB_PASSWORD=ChangeMe_Mysql_2026

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 应用 =====
SERVER_PORT=8080
SPRINGDOC_ENABLED=true

# ===== 安全密钥（生产环境必须替换，禁止提交真实值）=====
# JWT 密钥：不少于 32 字节的随机串
JWT_SECRET=ChangeMe_Jwt_Secret_At_Least_32_Bytes_Long_2026
JWT_TTL_SECONDS=7200
# AES-256 密钥：32 字节随机数的 Base64（示例值仅供本地联调）
AES_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# HMAC 密钥：用于手机号等值检索
HMAC_SECRET=ChangeMe_Hmac_Secret_2026
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15
LOG_HOME=logs

# ===== 短信通道（log=只打日志不真发，接入厂商后替换）=====
SMS_PROVIDER=log

# ===== 定时任务 =====
# 证件与车辆证照到期扫描，默认每日 08:00
JOB_CERT_WARN_CRON=0 0 8 * * ?
