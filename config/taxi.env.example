# =====================================================================
# 出租汽车运营监管平台 · 唯一运行时配置模板
# 使用：cp config/taxi.env.example config/taxi.env，再按环境修改
# 说明：Spring Boot、Docker Compose、systemd 均读取 config/taxi.env
# =====================================================================

# ===== 时区与端口 =====
TZ=Asia/Shanghai
SERVER_PORT=8080
PROTOCOL_PORT=7611

# ===== MySQL =====
# Docker Compose 用 mysql；裸机用 127.0.0.1 或数据库实际地址
DB_HOST=mysql
DB_PORT=3306
DB_NAME=taxi_platform
DB_USERNAME=root
DB_PASSWORD=ChangeMe_Mysql_2026

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 安全密钥（生产必须替换，禁止使用示例值）=====
# JWT_SECRET：至少 32 字节随机串
JWT_SECRET=ChangeMe_Jwt_Secret_At_Least_32_Bytes_Long_2026
JWT_TTL_SECONDS=7200
# AES_KEY：32 字节随机数的 Base64（示例值仅供本地联调）
AES_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# HMAC_SECRET：随机串，用于手机号等值检索
HMAC_SECRET=ChangeMe_Hmac_Secret_2026
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

# ===== 日志与接口文档 =====
LOG_HOME=logs
SPRINGDOC_ENABLED=true

# ===== 808 协议 =====
PROTOCOL_ENABLED=true
PROTOCOL_WORKER_THREADS=0
PROTOCOL_IDLE_SECONDS=180
PROTOCOL_AUTH_TTL=7d
PROTOCOL_SESSION_TTL=5m

# ===== 轨迹存储：无 TDengine 时用 mysql =====
TRACK_PROVIDER=mysql
TDENGINE_URL=http://tdengine:6041
TDENGINE_DATABASE=taxi_track
TDENGINE_USERNAME=root
TDENGINE_PASSWORD=taosdata

# ===== 媒体与 1078 =====
# 容器内工作目录为 /app，./media 即 /app/media
MEDIA_STORAGE_PATH=./media
MEDIA_HLS_BASE=http://127.0.0.1:8888
# 下发给终端的推流地址，必须是终端可访问的服务器 IP
MEDIA_PUSH_IP=127.0.0.1
MEDIA_PUSH_PORT=8554

# ===== 发票：未接诺诺前保持 true =====
INVOICE_MOCK=true
INVOICE_PDF_BASE=https://invoice.example.com/pdf

# ===== 报警升级（秒）=====
ALARM_LEVEL1_SECONDS=600
ALARM_LEVEL2_SECONDS=300

# ===== 结算 =====
BILLING_DEFAULT_DRIVER_SHARE=0.8000

# ===== CORS（逗号分隔，支持通配）=====
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ===== 短信与定时任务 =====
SMS_PROVIDER=log
JOB_CERT_WARN_CRON=0 0 8 * * ?
